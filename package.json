    "unpdf": "^2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "10.1.8",
    "jszip": "^3.10.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
