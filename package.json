{
  "name": "parent-translator",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first assistant that turns school documents into plain-language briefs for parents.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
