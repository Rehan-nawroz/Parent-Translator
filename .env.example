# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any real credential.

# --- Gemini (server only; never exposed to the browser) ---
GEMINI_API_KEY=
# Default model. Must support document (PDF/image) input and structured JSON output.
GEMINI_MODEL=gemini-3.8-flash

# --- Upload limits ---
# 10 MiB. Keep below the provider's 20 MB inline-request ceiling after base64 encoding.
MAX_UPLOAD_BYTES=10485760

# --- Supabase (public values are safe in the browser; service role key is server only) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Policy versions recorded with sign-up consent ---
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01

# --- Temporary hackathon quota ---
MAX_ANALYSES_PER_USER=3
